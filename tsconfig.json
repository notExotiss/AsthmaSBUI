{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "types": ["react", "react-dom"]
  },
  "include": [
    "app.tsx",
    "auth-flow.tsx",
    "firebase.ts",
    "firebase-data.ts",
    "firebase-sdk.d.ts",
    "ui.tsx",
    "theme.ts",
    "components/background-gradient.tsx"
  ]
}
